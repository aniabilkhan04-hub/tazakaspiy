# Скопируйте этот файл в .env и заполните значения

# Токен вашего Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Username бота без @ (нужен для кнопки «Открыть бота» на сайте)
BOT_USERNAME=

# Порт, на котором будет работать сайт
PORT=3000

# Пароль для входа в панель модерации (страница /admin.html).
# ОБЯЗАТЕЛЬНО придумайте свой длинный пароль. Если оставить пустым — модерация отключена.
ADMIN_PASSWORD=
